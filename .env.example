# Docker Compose
POSTGRES_VERSION=18-alpine
CONTAINER_NAME=postgres_18_db
RESTART_POLICY=always

# PostgreSQL Dev
DB_USER=burguer_house
DB_PASSWORD=change-me
DB_NAME=burguer_house

# Port mapping
HOST_PORT=5432
CONTAINER_PORT=5432

# Docker volume
VOLUME_NAME=pgdata

# PostgreSQL Test (porta 5433)
CONTAINER_NAME_TEST=postgres_test_db
DB_NAME_TEST=burguer_house_test
HOST_PORT_TEST=5433
VOLUME_NAME_TEST=pgdata_test
DATABASE_URL_TEST="postgresql://burguer_house:change-me@localhost:5433/burguer_house_test?schema=public"

# Autenticação JWT
JWT_SECRET="burguer-house-jwt-secret-key-change-in-prod"

