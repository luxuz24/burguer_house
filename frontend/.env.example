# Origem da API em producao (sem /api no final), ex.: https://burguer-house.koyeb.app
# Deixe vazio em desenvolvimento: o app chama /api e o proxy do Vite encaminha para o backend.
VITE_API_URL=

# Opcional (somente dev): backend para onde o proxy do Vite encaminha /api (padrao http://localhost:3000)
VITE_PROXY_TARGET=
