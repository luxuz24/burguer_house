# Prisma connection to the PostgreSQL container
DATABASE_URL="postgresql://burguer_house:change-me@localhost:5432/burguer_house?schema=public"
DATABASE_URL_TEST="postgresql://burguer_house:change-me@localhost:5433/burguer_house_test?schema=public"
# Ajustes opcionais do pool PostgreSQL (recomendado para Neon/serverless)
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000

# Segredo de assinatura JWT (obrigatório, mín. 16 chars). Gere: openssl rand -hex 32
JWT_SECRET=
# Segredo do webhook Anota AI (header x-webhook-secret ou ?token=)
ANOTAAI_WEBHOOK_SECRET=
# Modo sombra do webhook Anota AI: true grava payloads e simula consolidação (dry-run) sem abater estoque
ANOTAAI_MODO_SOMBRA=false
# Segredo do cron externo que dispara POST /api/vendas/consolidar (header x-cron-secret). Gere: openssl rand -hex 32
CRON_SECRET=
# Sufixos de host aceitos para consultar a SEFAZ via QR code (padrao: .gov.br)
# QRCODE_HOSTS_PERMITIDOS=.gov.br
# Atras de proxy (Koyeb/Render): numero de proxies a frente da API (ex.: 1) para usar o IP real do cliente no rate limit.
# "true" funciona, mas confia em todo o X-Forwarded-For (IP forjavel). false = sem proxy.
TRUST_PROXY=false
# Origens permitidas no CORS (separadas por virgula). Obrigatorio em producao, ex.: https://burguer-house.vercel.app
CORS_ORIGINS=
# Senha inicial do usuario ADMIN criado pelo seed (obrigatorio em producao; padrao em dev: admin123)
SEED_ADMIN_PASSWORD=
# Senha dos usuarios do banco de DEMONSTRACAO (npm run seed:demo; padrao: demo1234). Ver docs/DEMO_BANCA.md
SEED_DEMO_SENHA=
