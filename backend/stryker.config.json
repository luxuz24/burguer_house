{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": [
    "clear-text",
    "json"
  ],
  "ignorePatterns": [
    "reports",
    ".stryker-tmp"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "mutate": [
    "src/modules/auth/services/auth.service.ts",
    "src/modules/auth/repositories/usuarios.repository.ts",
    "src/infra/http/auth.guard.ts"
  ],
  "vitest": {
    "related": false,
    "dir": "src"
  },
  "tempDirName": ".stryker-tmp",
  "inPlace": true,
  "cleanTempDir": true,
  "concurrency": 1
}