// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Insumo {
  id                    String         @id @default(uuid())
  nome                  String
  unidade               String         
  fatorPerda            Float          @default(0) 
  estoqueAtual          Float          @default(0)
  estoqueMinimo         Float          @default(0)
  produzidoInternamente Boolean        @default(false)
  validadeDias          Int?
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  fichasTecnicas        FichaTecnica[]
  perdas                Perda[]
  ingredientesBeneficio SubFichaTecnica[] @relation("InsumoBeneficiado")
  usadoEmBeneficios     SubFichaTecnica[] @relation("InsumoBruto")

  @@map("insumos")
}

model Produto {
  id            String         @id @default(uuid())
  nome          String
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  fichasTecnicas FichaTecnica[]

  @@map("produtos")
}

model FichaTecnica {
  id            String         @id @default(uuid())
  produtoId     String
  insumoId      String
  quantidade    Float          
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo        Insumo         @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@map("fichas_tecnicas")
}

model Venda {
  id              String         @id @default(uuid())
  payloadOriginal Json           // Payload bruto da Anota AI (JSONB)
  processado      Boolean        @default(false)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  @@map("vendas")
}

enum MotivoPerda {
  VENCIMENTO
  ERRO_PREPARO
  ESTRAGADO
  OUTRO
}

model Perda {
  id         String      @id @default(uuid())
  insumoId   String
  quantidade Float
  motivo     MotivoPerda
  criadoEm   DateTime    @default(now())

  insumo     Insumo      @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@map("perdas")
}

model SubFichaTecnica {
  id                   String   @id @default(uuid())
  insumoBeneficiadoId  String
  insumoBrutoId        String
  quantidadeNecessaria Float
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  insumoBeneficiado    Insumo   @relation("InsumoBeneficiado", fields: [insumoBeneficiadoId], references: [id], onDelete: Cascade)
  insumoBruto          Insumo   @relation("InsumoBruto", fields: [insumoBrutoId], references: [id], onDelete: Restrict)

  @@unique([insumoBeneficiadoId, insumoBrutoId])
  @@map("sub_fichas_tecnicas")
}
