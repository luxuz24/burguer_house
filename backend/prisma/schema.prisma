// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Insumo {
  id                    String         @id @default(uuid())
  nome                  String
  unidade               String         
  fatorPerda            Float          @default(0) 
  custoUnitario         Float          @default(0)
  estoqueAtual          Float          @default(0)
  estoqueMinimo         Float          @default(0)
  produzidoInternamente Boolean        @default(false)
  validadeDias          Int?
  criadoEm              DateTime       @default(now())
  atualizadoEm          DateTime       @updatedAt

  fichasTecnicas        FichaTecnica[]
  perdas                Perda[]
  ingredientesBeneficio SubFichaTecnica[] @relation("InsumoBeneficiado")
  usadoEmBeneficios     SubFichaTecnica[] @relation("InsumoBruto")
  itensNotaFiscal       ItemNotaFiscal[]

  @@map("insumos")
}

model Produto {
  id            String         @id @default(uuid())
  nome          String
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  fichasTecnicas FichaTecnica[]

  @@map("produtos")
}

model FichaTecnica {
  id            String         @id @default(uuid())
  produtoId     String
  insumoId      String
  quantidade    Float          
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumo        Insumo         @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@unique([produtoId, insumoId])
  @@map("fichas_tecnicas")
}

model Venda {
  id              String         @id @default(uuid())
  externalId      String?        @unique
  payloadOriginal Json           // Payload bruto da Anota AI (JSONB)
  processado      Boolean        @default(false)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  @@map("vendas")
}

enum MotivoPerda {
  VENCIMENTO
  ERRO_PREPARO
  ESTRAGADO
  OUTRO
}

model Perda {
  id         String      @id @default(uuid())
  insumoId   String
  quantidade Float
  motivo     MotivoPerda
  criadoEm   DateTime    @default(now())

  insumo     Insumo      @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  @@map("perdas")
}

model SubFichaTecnica {
  id                   String   @id @default(uuid())
  insumoBeneficiadoId  String
  insumoBrutoId        String
  quantidadeNecessaria Float
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  insumoBeneficiado    Insumo   @relation("InsumoBeneficiado", fields: [insumoBeneficiadoId], references: [id], onDelete: Cascade)
  insumoBruto          Insumo   @relation("InsumoBruto", fields: [insumoBrutoId], references: [id], onDelete: Restrict)

  @@unique([insumoBeneficiadoId, insumoBrutoId])
  @@map("sub_fichas_tecnicas")
}

model NotaFiscal {
  id              String           @id @default(uuid())
  chaveAcesso     String           @unique // Chave de 44 dígitos da NF-e / NFC-e
  numero          String?
  serie           String?
  fornecedorNome  String           // Razão Social / Nome Fantasia do emitente
  fornecedorCnpj  String           // CNPJ ou CPF do emitente
  valorTotal      Float            // Valor total da nota (vNF / vProd)
  dataEmissao     DateTime         // Data/Hora de emissão (dhEmi)
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt

  itens           ItemNotaFiscal[]

  @@map("notas_fiscais")
}

model ItemNotaFiscal {
  id                   String      @id @default(uuid())
  notaFiscalId         String
  insumoId             String?     // Insumo vinculado no almoxarifado (opcional)
  descricaoOriginal    String      // xProd do XML
  unidadeOriginal      String      // uCom do XML (ex: CX, KG, UN)
  quantidadeOriginal   Float       // qCom do XML
  valorUnitario        Float       // vUnCom do XML
  valorTotal           Float       // vProd do XML
  quantidadeConvertida Float?      // Quantidade convertida para a unidade do insumo (ex: 5000g)
  criadoEm             DateTime    @default(now())

  notaFiscal           NotaFiscal  @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  insumo               Insumo?     @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  @@map("itens_nota_fiscal")
}

enum Role {
  ADMIN
  GERENTE
  OPERADOR
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senha        String   // Hash bcrypt
  telefone     String?
  role         Role     @default(OPERADOR)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}
